{
  "name": "mezo-agent-toolkit",
  "version": "0.2.1",
  "description": "Let any AI agent read Mezo and pay for it in MUSD with no BTC for gas: a lens contract, an MCP server and an x402 pay-per-call endpoint.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.Kylne700/mezo-agent-toolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kylne700/mezo-agent-toolkit.git"
  },
  "keywords": [
    "mezo",
    "musd",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "x402",
    "ai-agent",
    "bitcoin",
    "testnet"
  ],
  "bin": {
    "mezo-agent-toolkit": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build:contracts": "node scripts/compile.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "prepublishOnly": "npm run build:mcp && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "tsx src/server.ts",
    "dev": "npx --yes wrangler@4.151.1 dev",
    "deploy": "npx --yes wrangler@4.151.1 deploy",
    "mcp": "tsx src/mcp.ts",
    "smoke": "tsx scripts/smoke.ts",
    "worker:smoke": "tsx scripts/worker-smoke.ts",
    "mcp:session": "tsx scripts/mcp-session.ts",
    "gate": "tsx scripts/gate.ts",
    "w2:prove": "tsx scripts/w2-prove.ts",
    "w2:check": "tsx scripts/w2-check.ts",
    "w2:paid": "tsx scripts/w2-paid.ts",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:licences": "node scripts/licence-check.mjs",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check": "npm run check:secrets && npm run check:licences && npm run check:privacy"
  },
  "dependencies": {},
  "devDependencies": {
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "hono": "^4.13.13",
    "solc": "0.8.36",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.7",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
